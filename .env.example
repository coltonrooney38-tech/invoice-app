# Copy to .env and fill in. Never commit .env.

# Trigger.dev (cloud.trigger.dev → your project → API keys). Use the DEV key
# locally; Vercel gets the PROD key (tr_prod_...).
TRIGGER_SECRET_KEY=

# Composio (platform.composio.dev → Settings → API Keys). Only the Trigger.dev
# task uses these; add them to Trigger.dev → Production → Environment Variables too.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Password for the invoice form (make up something long)
FORM_PASSWORD=
